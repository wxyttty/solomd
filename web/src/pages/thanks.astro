---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import thanksData from '../data/thanks.json';
import { sponsors, promoters, testers } from '../lib/supporters';

const lang = 'en' as const;

interface Donor {
  name: string;
  date: string;
  platform: 'wechat' | 'alipay' | 'paypal' | 'github' | 'other';
  amount?: string;
  message?: string;
}

// Newest first.
const donors: Donor[] = [...(thanksData.donors as Donor[])].sort(
  (a, b) => (a.date < b.date ? 1 : -1),
);

const platformLabel: Record<Donor['platform'], string> = {
  wechat: 'WeChat Pay',
  alipay: 'Alipay',
  paypal: 'PayPal',
  github: 'GitHub Sponsors',
  other: 'Other',
};
---

<Layout
  title="Thanks — Sponsors, promoters and supporters of SoloMD"
  description="A thank-you wall for everyone who has sponsored, promoted or tipped SoloMD."
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <section class="container thanks-page">
      <h1>Thanks ♥</h1>
      <p class="lead">
        SoloMD is free and open source. These kind souls chose to send a tip
        anyway — their contributions fund the occasional coffee and the
        occasional Apple Developer renewal. Thank you.
      </p>


      {sponsors.length > 0 && (
        <section class="supporters">
          <h2>Sponsors</h2>
          <ul class="supporters__list">
            {sponsors.map((x) => (
              <li>{x.url ? <a href={x.url} target="_blank" rel="noopener">{x.name}</a> : x.name}<span class="supporters__since">{x.since}</span></li>
            ))}
          </ul>
        </section>
      )}

      {testers.length > 0 && (
        <section class="supporters">
          <h2>Testers</h2>
          <p class="supporters__lead">People who test SoloMD carefully and send detailed bug reports — many fixes start with them.</p>
          <ul class="supporters__list">
            {testers.map((x) => (
              <li>{x.github ? <a href={`https://github.com/${x.github}`} target="_blank" rel="noopener">{x.name}</a> : <strong>{x.name}</strong>}<span class="supporters__since">{x.since}</span><p class="supporters__lead">{x.contribution.en}</p></li>
            ))}
          </ul>
        </section>
      )}

      <section class="supporters">
        <h2>Promoters</h2>
        <p class="supporters__lead" set:html={'People who wrote about SoloMD, made a video or recommended it. <a href="/promote">How to become one →</a>'} />
        {promoters.length === 0 ? (
          <p class="empty">No promoters yet — be the first.</p>
        ) : (
          <ul class="supporters__list">
            {promoters.map((x) => (
              <li><a href={x.url} target="_blank" rel="noopener">{x.name}</a><span class="supporters__since">{x.platform} · {x.since}</span></li>
            ))}
          </ul>
        )}
      </section>

      <h2 class="tips-heading">Tips</h2>
      {donors.length === 0 ? (
        <p class="empty">No supporters yet — be the first!</p>
      ) : (
        <ul class="donors">
          {donors.map((d) => (
            <li class="donor">
              <div class="donor__head">
                <span class="donor__name">{d.name}</span>
                {d.amount ? <span class="donor__amount">{d.amount}</span> : null}
              </div>
              <div class="donor__meta">
                <time>{d.date}</time>
                <span class="donor__platform">· {platformLabel[d.platform]}</span>
              </div>
              {d.message ? <p class="donor__message">“{d.message}”</p> : null}
            </li>
          ))}
        </ul>
      )}

      <section class="support">
        <h2>Want to support SoloMD?</h2>
        <p>
          PayPal, WeChat Pay, and Alipay options are on the
          <a href="/#sponsor"> sponsor section of the home page</a>. After
          tipping, feel free to open a
          <a href="https://github.com/zhitongblog/solomd/issues" rel="external">
            GitHub issue
          </a>
          with the title "Thanks list" and your preferred display name + optional
          message. I'll add you here.
        </p>
        <p class="privacy-note">
          Privacy: I never publish an amount or message unless you explicitly
          opt in. Use "Anonymous" / "匿名" as the name if you'd rather not be
          listed at all — in which case I just say thanks privately.
        </p>
      </section>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .thanks-page { max-width: 720px; padding: 40px 20px 80px; }
  .thanks-page h1 { font-size: 2rem; margin: 10px 0 14px; color: #ff9f40; }
  .thanks-page .lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-muted, #555);
    margin-bottom: 32px;
  }
  .empty { color: var(--text-faint, #888); font-style: italic; }
  .donors { list-style: none; padding: 0; margin: 0 0 48px; }
  .donor {
    padding: 14px 0;
    border-bottom: 1px dashed #eee;
  }
  .donor:last-child { border-bottom: 0; }
  .donor__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .donor__name { font-weight: 600; font-size: 1rem; }
  .donor__amount { color: #ff9f40; font-size: 0.95rem; font-variant-numeric: tabular-nums; }
  .donor__meta {
    font-size: 12px;
    color: var(--text-faint, #999);
    margin-top: 2px;
  }
  .donor__platform { margin-left: 2px; }
  .donor__message {
    margin: 8px 0 0;
    color: var(--text-muted, #555);
    font-style: italic;
    line-height: 1.6;
  }
  .support {
    margin-top: 40px;
    padding: 24px;
    background: var(--bg-soft, #fafaf7);
    border-radius: 10px;
    border: 1px solid #eee;
  }
  .support h2 { margin: 0 0 12px; font-size: 1.1rem; }
  .support p { margin: 8px 0; line-height: 1.7; color: var(--text-muted, #555); }
  .privacy-note { font-size: 0.9rem; color: var(--text-faint, #888); }
  .supporters { margin: 0 0 32px; }
  .supporters h2, .tips-heading { font-size: 1.2rem; margin: 0 0 12px; }
  .supporters__lead { color: var(--text-muted, #555); line-height: 1.7; margin: 0 0 12px; }
  .supporters__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .supporters__list li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border, #eee); font-weight: 600; }
  .supporters__since { font-weight: 400; color: var(--text-faint, #888); font-size: 0.9rem; }
</style>
