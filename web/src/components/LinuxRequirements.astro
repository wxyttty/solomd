---
// "Can my Linux run SoloMD?" — written for people who don't know what glibc
// or WebKitGTK are. The flowchart is plain HTML (not an image/SVG) so it
// wraps on phones, follows the dark theme and stays selectable/translatable.
//
// The two hard floors come from the shipped binaries, not from a setting we
// could lower: every Linux bundle needs glibc ≥ 2.34 (highest versioned
// symbol in the 4.14.4 binary) and WebKitGTK 4.1 + libsoup 3 (Tauri 2). The
// .deb/.rpm take WebKitGTK from the system; the AppImage carries its own, so
// it only needs the glibc floor.
interface Props { lang: 'zh' | 'en' }
const { lang } = Astro.props;
const zh = lang === 'zh';

type Row = { os: string; ok: boolean; pkg: string };
const rows: Row[] = zh
  ? [
      { os: 'Ubuntu 22.04 / 24.04 及更新', ok: true, pkg: '.deb' },
      { os: 'Ubuntu 20.04 及更早', ok: false, pkg: '升级到 22.04 或更新' },
      { os: 'Debian 12 / 13', ok: true, pkg: '.deb' },
      { os: 'Debian 11 及更早', ok: false, pkg: '升级到 Debian 12 或更新' },
      { os: 'Linux Mint 21 / 22', ok: true, pkg: '.deb' },
      { os: 'Linux Mint 20 及更早', ok: false, pkg: '升级到 Mint 21 或更新' },
      { os: '深度 Deepin 23', ok: true, pkg: '.AppImage（最省心）或 .deb' },
      { os: '深度 Deepin 20 / 统信 UOS 20', ok: false, pkg: '系统太旧，暂无办法' },
      { os: '银河麒麟 Kylin V10', ok: false, pkg: '系统太旧，暂无办法' },
      { os: 'Fedora 36 及更新', ok: true, pkg: '.rpm' },
      { os: 'Rocky / AlmaLinux / RHEL 9', ok: true, pkg: '.AppImage' },
      { os: 'CentOS 7 / 8、RHEL 8', ok: false, pkg: '升级到 9 系' },
      { os: 'openSUSE Tumbleweed / Leap 16', ok: true, pkg: '.rpm' },
      { os: 'openSUSE Leap 15', ok: false, pkg: '升级到 Leap 16' },
      { os: 'Arch / Manjaro / EndeavourOS', ok: true, pkg: 'AUR：yay -S solomd-bin' },
    ]
  : [
      { os: 'Ubuntu 22.04 / 24.04 and newer', ok: true, pkg: '.deb' },
      { os: 'Ubuntu 20.04 and older', ok: false, pkg: 'Upgrade to 22.04 or newer' },
      { os: 'Debian 12 / 13', ok: true, pkg: '.deb' },
      { os: 'Debian 11 and older', ok: false, pkg: 'Upgrade to Debian 12 or newer' },
      { os: 'Linux Mint 21 / 22', ok: true, pkg: '.deb' },
      { os: 'Linux Mint 20 and older', ok: false, pkg: 'Upgrade to Mint 21 or newer' },
      { os: 'Deepin 23', ok: true, pkg: '.AppImage (easiest) or .deb' },
      { os: 'Deepin 20 / UOS 20', ok: false, pkg: 'Too old — no workaround yet' },
      { os: 'Kylin V10', ok: false, pkg: 'Too old — no workaround yet' },
      { os: 'Fedora 36 and newer', ok: true, pkg: '.rpm' },
      { os: 'Rocky / AlmaLinux / RHEL 9', ok: true, pkg: '.AppImage' },
      { os: 'CentOS 7 / 8, RHEL 8', ok: false, pkg: 'Upgrade to a 9.x release' },
      { os: 'openSUSE Tumbleweed / Leap 16', ok: true, pkg: '.rpm' },
      { os: 'openSUSE Leap 15', ok: false, pkg: 'Upgrade to Leap 16' },
      { os: 'Arch / Manjaro / EndeavourOS', ok: true, pkg: 'AUR: yay -S solomd-bin' },
    ];

const pkgs = zh
  ? [
      { who: 'Ubuntu、Debian、Linux Mint、深度 Deepin 等', file: '.deb', how: '双击用「软件中心」安装，或在终端运行', cmd: 'sudo apt install ./SoloMD_*.deb' },
      { who: 'Fedora、Rocky、openSUSE 等', file: '.rpm', how: '双击安装，或在终端运行', cmd: 'sudo dnf install ./SoloMD-*.rpm' },
      { who: 'Arch、Manjaro 等', file: 'AUR', how: '在终端运行', cmd: 'yay -S solomd-bin' },
      { who: '不确定，或者 .deb / .rpm 提示缺少 libwebkit2gtk-4.1', file: '.AppImage', how: '不用安装，自带运行所需的组件。下载后在终端运行', cmd: 'chmod +x SoloMD_*.AppImage && ./SoloMD_*.AppImage' },
    ]
  : [
      { who: 'Ubuntu, Debian, Linux Mint, Deepin …', file: '.deb', how: 'Double-click to open it in your Software app, or run', cmd: 'sudo apt install ./SoloMD_*.deb' },
      { who: 'Fedora, Rocky, openSUSE …', file: '.rpm', how: 'Double-click to install, or run', cmd: 'sudo dnf install ./SoloMD-*.rpm' },
      { who: 'Arch, Manjaro …', file: 'AUR', how: 'Run', cmd: 'yay -S solomd-bin' },
      { who: 'Not sure — or .deb / .rpm complains that libwebkit2gtk-4.1 is missing', file: '.AppImage', how: 'Nothing to install: it carries the parts it needs. After downloading, run', cmd: 'chmod +x SoloMD_*.AppImage && ./SoloMD_*.AppImage' },
    ];

const home = zh ? '/zh/' : '/';
const issues = 'https://github.com/zhitongblog/solomd/issues/new';
---

<article class="container docs-article linux-req">
  <nav class="breadcrumbs">
    <a href={home}>{zh ? '首页' : 'Home'}</a> / <a href={`${home}docs/`}>{zh ? '文档' : 'Docs'}</a> /
    <span>{zh ? 'Linux 系统要求' : 'Linux requirements'}</span>
  </nav>

  <h1>{zh ? '我的 Linux 能装 SoloMD 吗？' : 'Will SoloMD run on my Linux?'}</h1>
  <p class="lead">
    {zh
      ? '2022 年以后发布的 Linux 系统基本都能直接用，装不上的通常是比较老的系统。照着下面这张图走一遍，大约两分钟就能知道结果，也能知道该下载哪个文件。'
      : 'Almost any Linux released since 2022 works out of the box; the ones that don’t are older systems. Follow the chart below — it takes about two minutes and also tells you which file to download.'}
  </p>

  <h2>{zh ? '一张图看懂' : 'The whole thing in one chart'}</h2>

  <ol class="flow" aria-label={zh ? '判断流程' : 'Decision chart'}>
    <li class="node step">
      <span class="badge">1</span>
      <div>
        <strong>{zh ? '打开「终端」' : 'Open a terminal'}</strong>
        <p>{zh ? '在应用菜单里搜索「终端」，或者按 Ctrl + Alt + T。' : 'Search your app menu for “Terminal”, or press Ctrl + Alt + T.'}</p>
      </div>
    </li>
    <li class="arrow" aria-hidden="true"></li>
    <li class="node step">
      <span class="badge">2</span>
      <div>
        <strong>{zh ? '输入下面这行，按回车' : 'Type this line and press Enter'}</strong>
        <pre><code>ldd --version</code></pre>
        <p>
          {zh ? '只看第一行最后面的数字，例如：' : 'Look only at the number at the very end of the first line, for example:'}
        </p>
        <pre class="sample"><code>ldd (Ubuntu GLIBC 2.35-0ubuntu3.8) <mark>2.35</mark></code></pre>
      </div>
    </li>
    <li class="arrow" aria-hidden="true"></li>
    <li class="node decision">
      <strong>{zh ? '这个数字是 2.34 或更大吗？' : 'Is that number 2.34 or higher?'}</strong>
      <p>{zh ? '2.35、2.36、2.39 都算「是」；2.31、2.28、2.17 都算「否」。' : '2.35, 2.36, 2.39 all count as “yes”; 2.31, 2.28, 2.17 count as “no”.'}</p>
    </li>
    <li class="branches">
      <div class="branch branch--no">
        <span class="label">{zh ? '否' : 'No'}</span>
        <div class="node end end--no">
          <strong>{zh ? '这台电脑的系统太旧了' : 'This system is too old'}</strong>
          <p>
            {zh
              ? '目前没法在它上面运行 SoloMD，换哪个安装包都一样。办法是把系统升级到下面表格里标 ✅ 的版本。'
              : 'SoloMD can’t run on it yet — no download will change that. The fix is to upgrade to a release marked ✅ in the table below.'}
          </p>
          <a href="#table">{zh ? '看看升级到哪个版本 ↓' : 'See which release to upgrade to ↓'}</a>
        </div>
      </div>
      <div class="branch branch--yes">
        <span class="label">{zh ? '是' : 'Yes'}</span>
        <div class="node end end--yes">
          <strong>{zh ? '可以装 👍' : 'You’re good 👍'}</strong>
          <p>{zh ? '继续第 3 步，选一个安装包。' : 'Go on to step 3 and pick a file.'}</p>
          <a href="#pick">{zh ? '第 3 步 ↓' : 'Step 3 ↓'}</a>
        </div>
      </div>
    </li>
  </ol>

  <div class="node step step3" id="pick">
    <span class="badge">3</span>
    <div>
      <strong>{zh ? '选安装包（只有上一步答「是」才需要）' : 'Pick a file (only if you answered “yes”)'}</strong>
      <p>{zh ? '按你的系统，在下面四个里选一个就行：' : 'By your system, choose one of these four:'}</p>
    </div>
  </div>

  <div class="pkg-grid">
    {pkgs.map((p) => (
      <div class="pkg">
        <span class="pkg__file">{p.file}</span>
        <p class="pkg__who">{p.who}</p>
        <p class="pkg__how">{p.how}</p>
        <pre><code>{p.cmd}</code></pre>
      </div>
    ))}
  </div>

  <p class="aside">
    {zh ? '每种文件都有两个版本。大多数电脑选 ' : 'Every file comes in two builds. Most computers want '}
    <code>amd64</code> / <code>x86_64</code>{zh ? '；树莓派这类 ARM 电脑选 ' : '; ARM machines such as a Raspberry Pi want '}
    <code>arm64</code> / <code>aarch64</code>{zh ? '。不确定的话，在终端运行 ' : '. Not sure? Run '}
    <code>uname -m</code>{zh ? '，显示 aarch64 就是 ARM。' : ' — if it prints aarch64, it’s ARM.'}
  </p>

  <h2 id="table">{zh ? '不想敲命令？直接查表' : 'Rather not type commands? Look it up'}</h2>
  <p>
    {zh
      ? '下面是常见的系统。表里没有的，或者你改过系统的，以上面 ldd 命令的结果为准。'
      : 'These are the common ones. If yours isn’t listed, or you’ve customised your system, trust the ldd check above.'}
  </p>
  <div class="table-wrap">
    <table class="kb-table">
      <thead><tr><th>{zh ? '系统' : 'System'}</th><th>{zh ? '能用吗' : 'Works?'}</th><th>{zh ? '下载哪个 / 怎么办' : 'Download / what to do'}</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr class={r.ok ? 'ok' : 'no'}>
            <th>{r.os}</th>
            <td>{r.ok ? '✅' : '❌'}</td>
            <td>{r.pkg}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>{zh ? '为什么老系统装不上？' : 'Why don’t older systems work?'}</h2>
  <p>
    {zh
      ? 'SoloMD 不自带一整套界面程序，而是借用系统里现成的两样东西：显示界面用的「网页引擎」（WebKitGTK），以及所有程序都要用到的「基础运行库」（glibc）。好比家具要装在墙上，墙得有对应的挂钩。'
      : 'SoloMD doesn’t ship a whole user-interface stack of its own. It borrows two things your system already has: a “web engine” that draws the window (WebKitGTK) and the “base library” every program uses (glibc). Think of furniture that mounts on a wall — the wall needs the right brackets.'}
  </p>
  <p>
    {zh
      ? '2022 年左右以后的系统才有我们需要的「挂钩」：glibc 2.34 以上、WebKitGTK 4.1。再老的系统要么版本太低，要么根本没有这个网页引擎。这是 SoloMD 所用的开发框架（Tauri 2）定下的底线，不是一个我们调低就能解决的数字，所以升级系统是唯一可靠的办法。AppImage 自带网页引擎，所以比 .deb / .rpm 少一个要求，但基础运行库它也带不了。'
      : 'Systems from around 2022 onward have the brackets we need: glibc 2.34 or newer and WebKitGTK 4.1. Older systems have versions that are too low, or no such web engine at all. That floor comes from the framework SoloMD is built on (Tauri 2) — it isn’t a number we can simply turn down — so upgrading the system is the only reliable fix. The AppImage carries its own web engine, so it needs one thing less than .deb / .rpm, but it can’t carry the base library.'}
  </p>

  <h2>{zh ? '照着做了还是不行？' : 'Followed the chart and it still fails?'}</h2>
  <p>
    {zh ? '请到 ' : 'Please '}
    <a href={issues} rel="external">{zh ? 'GitHub 提一个 issue' : 'open an issue on GitHub'}</a>
    {zh ? '，把下面三行命令的输出一起贴上，我们就能很快判断原因：' : ' and paste the output of these three commands — it lets us tell what’s wrong quickly:'}
  </p>
  <pre><code>ldd --version | head -1
grep PRETTY_NAME /etc/os-release
uname -m</code></pre>
</article>

<style>
  .docs-article { max-width: 820px; padding: 40px 20px 80px; }
  .docs-article h1 { font-size: 2rem; margin: 10px 0 16px; }
  .docs-article h2 { font-size: 1.4rem; margin: 40px 0 12px; }
  .docs-article .lead { color: var(--text-muted); margin-bottom: 24px; line-height: 1.6; font-size: 1.05rem; }
  .docs-article code { background: var(--bg-soft); padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
  .docs-article pre { background: var(--bg-soft); padding: 10px 14px; border-radius: 6px; overflow-x: auto; margin: 8px 0; }
  .docs-article pre code { background: none; padding: 0; }
  .breadcrumbs { font-size: 0.9rem; color: var(--text-muted); }

  /* ---- flowchart ---- */
  .flow { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-direction: column; align-items: center; }
  .node { width: 100%; max-width: 560px; background: var(--bg-elev); border: 1px solid var(--border); border-radius: 10px; padding: 14px 18px; }
  .node p { margin: 6px 0 0; color: var(--text-muted); line-height: 1.55; }
  .node strong { font-size: 1.02rem; }
  .step { display: flex; gap: 14px; align-items: flex-start; }
  .step > div { min-width: 0; flex: 1; }
  .badge { flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 700; display: grid; place-items: center; }
  .sample { white-space: pre-wrap; word-break: break-word; }
  .sample mark { background: var(--accent-soft); color: inherit; padding: 0 3px; border-radius: 3px; outline: 2px solid var(--accent); }
  .arrow { width: 2px; height: 28px; background: var(--text-faint); position: relative; margin-bottom: 6px; }
  .arrow::after { content: ''; position: absolute; left: 50%; bottom: -6px; transform: translateX(-50%); border: 6px solid transparent; border-top-color: var(--text-faint); border-bottom: 0; }
  .decision { text-align: center; border: 2px dashed var(--accent); background: var(--accent-soft); }
  .decision p { color: var(--text); }
  .branches { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; width: 100%; margin-top: 4px; }
  .branch { display: flex; flex-direction: column; align-items: center; }
  .branch .label { font-weight: 700; font-size: 0.95rem; padding: 18px 0 8px; position: relative; }
  .branch .label::before { content: ''; position: absolute; top: 0; left: 50%; width: 2px; height: 16px; background: var(--text-faint); }
  .end { flex: none; }
  .step3 { margin: 28px auto 0; }
  .end a { display: inline-block; margin-top: 8px; font-weight: 600; }
  .end--no { border-left: 4px solid #d9534f; }
  .end--yes { border-left: 4px solid #3f9d5a; }
  .branch--no .label { color: #d9534f; }
  .branch--yes .label { color: #3f9d5a; }

  .pkg-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 16px 0; }
  .pkg { border: 1px solid var(--border); border-top: 3px solid #3f9d5a; border-radius: 10px; padding: 12px 14px; background: var(--bg-elev); min-width: 0; }
  .pkg__file { font-family: var(--font-mono); font-weight: 700; font-size: 1.05rem; }
  .pkg__who { margin: 4px 0; font-weight: 600; }
  .pkg__how { margin: 4px 0; color: var(--text-muted); font-size: 0.92rem; }
  .pkg pre { font-size: 0.82rem; white-space: pre-wrap; word-break: break-all; }
  .aside { color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; }

  .table-wrap { overflow-x: auto; }
  .kb-table { width: 100%; border-collapse: collapse; margin: 14px 0 20px; font-size: 14px; }
  .kb-table th, .kb-table td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--border); }
  .kb-table thead th { background: var(--bg-soft); font-weight: 600; }
  .kb-table tbody th { font-weight: 500; }
  .kb-table tr.no td:last-child { color: var(--text-muted); }

  @media (max-width: 620px) {
    .branches, .pkg-grid { grid-template-columns: 1fr; }
    .branch--yes { order: -1; }
  }
</style>
