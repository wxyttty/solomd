---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Promote from '../components/Promote.astro';
const lang = 'en' as const;
---

<Layout
  title="Help spread SoloMD — the promoter program"
  description="Write about SoloMD, make a video or recommend it — and get listed on the thank-you wall, in the app's About dialog and among the README contributors."
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <Promote lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
