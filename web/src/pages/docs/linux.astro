---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LinuxRequirements from '../../components/LinuxRequirements.astro';

const lang = 'en' as const;
---

<Layout
  title="Linux requirements — will SoloMD run on my system?"
  description="Find out in two minutes whether your Linux can run SoloMD, and whether to download the .deb, .rpm, AUR package or AppImage. With a distro table and a flowchart."
  lang={lang}
>
  <Header lang={lang} />
  <main id="main">
    <LinuxRequirements lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
